{
  "manifest_version": 3,
  "name": "IPTUBE · Theme Studio",
  "description": "YouTube ad cleanup, optional SponsorBlock, playback tools, and nine movie and gaming themes with live switching.",
  "version": "2.4.0",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://sponsorblock.inf.re/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["playbackSafety.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["earlyPatch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["playerQuality.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "themeSettings.js",
        "featureSettings.js",
        "contentConfig.js",
        "sidebar.js",
        "mediaControls.js",
        "branding.js",
        "videoSettings.js",
        "browserFeatures.js",
        "themeController.js",
        "contentScript.js",
        "backgroundRandomizer.js"
      ],
      "css": ["style.css", "themes.css", "browserFeatures.css"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_rules",
        "enabled": false,
        "path": "rules/rules_1.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "spatial-audio.svg",
        "background/1.svg",
        "background/2.svg",
        "background/3.svg",
        "background/4.svg",
        "background/5.svg",
        "background/6.svg",
        "background/7.svg",
        "themes/breaking-bad.svg",
        "themes/game-of-thrones.png",
        "themes/gta-vi.png",
        "themes/modern-warfare.png",
        "themes/netflix.png",
        "themes/ps5.png",
        "themes/xbox.png"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "IPTUBE · Theme Studio",
    "default_popup": "popup.html"
  }
}
