{
  "manifest_version": 3,
  "name": "STRANGER THINGS EDITION",
  "description": "YouTube ad cleanup, optional SponsorBlock, playback tools, and Stranger Things effects for desktop browsers.",
  "version": "2.3.0",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "browsingData"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://sponsorblock.inf.re/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["storageSanitizer.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["antiBot.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["earlyPatch.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["playerQuality.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "featureSettings.js",
        "contentConfig.js",
        "sidebar.js",
        "mediaControls.js",
        "branding.js",
        "videoSettings.js",
        "browserFeatures.js",
        "contentScript.js",
        "backgroundRandomizer.js"
      ],
      "css": ["style.css", "browserFeatures.css"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_rules",
        "enabled": true,
        "path": "rules/rules_1.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "spatial-audio.svg",
        "background/1.svg",
        "background/2.svg",
        "background/3.svg",
        "background/4.svg",
        "background/5.svg",
        "background/6.svg",
        "background/7.svg"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_title": "STRANGER THINGS EDITION",
    "default_popup": "popup.html"
  }
}
